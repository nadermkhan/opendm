{
    "name"                     : "IDM Integration Module",
    "description"              : "__MSG_extension_desc__",
    "version"                  : "6.43.1",
    "author"                   : "Tonec FZE",
    "homepage_url"             : "http://www.internetdownloadmanager.com/",
    "default_locale"           : "en",

    "icons"                    : { "16": "images/logo16.png", "48": "images/logo48.png", "128": "images/logo128.png" },
    "action"                   : { "default_icon": { "16": "images/logo16.png", "32": "images/logo32.png" } },

    "background"               : { "scripts": [ "background.js" ] },
    "content_scripts"          : [
        { "js": [ "document.js" ], "matches": [ "*://*.youtube.com/*" ], "run_at": "document_start", "world": "MAIN" },
        { "js": [ "content.js" ], "matches": [ "*://*/*" ], "all_frames": true, "run_at": "document_start" }
    ],
    "web_accessible_resources" : [ { "resources": [ "document.js", "debug.js", "captured.js", "captured.html", "images/*" ], "matches": [ "*://*/*" ] } ],
    "permissions"              : [ "scripting", "tabs", "cookies", "contextMenus", "webNavigation", "webRequest", "webRequestBlocking", "declarativeNetRequest", "downloads", "management", "storage", "proxy", "nativeMessaging" ],
    "optional_permissions"     : [ "notifications" ],
    "host_permissions"         : [ "<all_urls>" ],

    "browser_specific_settings": {
        "gecko": {
            "id": "mozilla_cc@tonec.com",
            "strict_min_version": "109.0"
        }
    },
    "manifest_version"         : 3
}
